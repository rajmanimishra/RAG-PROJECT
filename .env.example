GOOGLE_API_KEY=replace_with_your_google_api_key
GROQ_API_KEY=replace_with_your_groq_api_key
# Optional. Defaults to the Groq model already used by this project.
# GROQ_MODEL=openai/gpt-oss-20b

# Optional. Enables conservative embedding-based answer reuse.
# RAG_SEMANTIC_CACHE_ENABLED=false

# Optional estimated LLM cost per answer in USD; defaults to zero.
# RAG_ESTIMATED_LLM_COST_PER_CALL_USD=0
